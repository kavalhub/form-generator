{
    "name": "kavalhub/form-generator",
    "description": "Easily create, validate, and display forms.",
    "type": "library",
    "keywords": ["PHP", "Form", "Validation form"],
    "homepage": "https://github.com/kavalhub/form-generator.git",
    "license": "MIT",
    "version": "3.0.0",
    "autoload": {
        "psr-4": {
            "Kavalhub\\FormGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kavalhub\\Example\\": "example/",
            "Kavalhub\\Tests\\FormGenerator\\": "tests/",
            "Kavalhub\\FormGenerator\\Laravel\\": "packages/laravel/src/",
            "Kavalhub\\Tests\\FormGenerator\\Laravel\\": "packages/laravel/tests/"
        }
    },
    "archive": {
        "exclude": [
            "example",
            "tests",
            "packages/laravel/tests",
            ".git",
            ".github",
            "phpunit.xml.dist"
        ]
    },
    "authors": [
        {
            "name": "Каменев Валерий",
            "email": "valick1977@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "kavalhub/form-generator-laravel": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel"
        }
    ],
    "suggest": {
        "kavalhub/form-generator-laravel": "Адаптеры Request и Validator для Laravel",
        "kavalhub/form-generator-bootstrap": "Bootstrap-декоратор (пока входит в основной пакет, будет вынесен в 3.x)"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.2.31"
        }
    }
}
