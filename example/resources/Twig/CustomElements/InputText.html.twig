{% do element.addClass(['fg-twig-input']) %}
{% set error = element.error is not empty ? '<div class="fg-twig-error">' ~ element.displayErrors ~ '</div>' : '' %}
<div class="fg-twig-field fg-twig-field--accent-success">
  <div class="fg-twig-template-meta">
    <span class="fg-twig-badge fg-twig-badge--success">Кастомный шаблон</span>
    <span class="fg-twig-template-path">resources/Twig/CustomElements/InputText.html.twig</span>
  </div>
  {{ element.render()|raw }}{{ error|raw }}
</div>
