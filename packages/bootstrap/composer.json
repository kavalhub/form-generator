{
    "name": "kavalhub/form-generator-bootstrap",
    "description": "Bootstrap decorator and templates for kavalhub/form-generator",
    "type": "library",
    "license": "MIT",
    "keywords": ["PHP", "Form", "Bootstrap", "Decorator"],
    "homepage": "https://github.com/kavalhub/form-generator.git",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "kavalhub/form-generator": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Kavalhub\\FormGenerator\\Bootstrap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kavalhub\\Tests\\FormGenerator\\Bootstrap\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
