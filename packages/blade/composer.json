{
    "name": "kavalhub/form-generator-blade",
    "description": "Blade decorator and templates for kavalhub/form-generator",
    "type": "library",
    "license": "MIT",
    "keywords": ["PHP", "Form", "Blade", "Decorator"],
    "homepage": "https://github.com/kavalhub/form-generator.git",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "kavalhub/form-generator": "^3.3",
        "illuminate/view": "^10.48|^11.0",
        "illuminate/filesystem": "^10.48|^11.0",
        "illuminate/events": "^10.48|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Kavalhub\\FormGenerator\\Blade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kavalhub\\Tests\\FormGenerator\\Blade\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
