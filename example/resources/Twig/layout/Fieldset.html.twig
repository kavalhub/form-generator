<fieldset class="fg-twig-fieldset">
  <legend class="fg-twig-legend">
    {% for child in element.all %}
      {% if loop.first %}{{ child.render()|striptags }}{% endif %}
    {% endfor %}
  </legend>
  <div class="fg-twig-fieldset-options">
  {% for child in element.all %}
    {% if not loop.first %}
      <span class="fg-twig-inline-option">{{ decorator.decorateChild(child).render|raw }}</span>
    {% endif %}
  {% endfor %}
  </div>
</fieldset>
