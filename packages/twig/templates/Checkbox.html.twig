{% set error = element.error is not empty ? '<div class="fg-twig-error">' ~ element.displayErrors ~ '</div>' : '' %}
{% do element.addClass(['fg-twig-check-input']) %}
<div class="fg-twig-field">
  <label class="fg-twig-label" for="{{ element.id }}">{{ element.title }}</label>
  <label class="fg-twig-switch" for="{{ element.id }}">
    {{ element.renderControl()|raw }}
    <span class="fg-twig-switch-track" aria-hidden="true"></span>
  </label>
  {{ error|raw }}
</div>