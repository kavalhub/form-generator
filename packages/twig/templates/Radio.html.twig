{% set error = element.error is not empty ? '<div class="fg-twig-error">' ~ element.displayErrors ~ '</div>' : '' %}
{% set parts = [] %}
{% for child in element.all %}
  {% set parts = parts|merge([decorator.decorateChild(child).render]) %}
{% endfor %}
<div class="fg-twig-field fg-twig-group">
  <div class="fg-twig-label">{{ element.title }}</div>
  {{ parts|join('')|raw }}{{ error|raw }}
</div>